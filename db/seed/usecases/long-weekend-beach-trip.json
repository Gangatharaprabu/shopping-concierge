    },
    "duration": {
      "type": "duration",
      "label": "Trip length",
      "max_days": 10,
      "default": {
        "unit": "days",
        "count": 3
      }
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [
        "low",
        "mid",
        "high"
      ],
      "default": "mid"
    },
    "dietary": {
