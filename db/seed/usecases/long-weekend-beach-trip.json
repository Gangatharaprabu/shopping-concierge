      "item_id": "beach_umbrella",
      "name": "Beach umbrella",
      "category": "gear",
      "qty": { "base": 1, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "step", "tiers": [ { "up_to": 4, "qty": 1 }, { "up_to": null, "qty": 2 } ] } ]
    },
    {
      "item_id": "after_sun_lotion",
      "name": "After-sun lotion",
      "category": "toiletries",
