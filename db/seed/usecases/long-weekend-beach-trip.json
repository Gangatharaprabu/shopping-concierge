    },
    {
      "item_id": "premium_beach_cabana_rental",
      "name": "Premium beach cabana rental",
      "category": "rental",
      "qty": { "base": 0, "unit": "rental" },
      "depends_on_slots": [ "budget_tier" ],
      "presence_rules": [ { "slot_id": "budget_tier", "condition": "equals", "value": "high" } ]
    }
