{
  "id": "super-bowl-watch-party",
  "title": "Super Bowl Watch Party",
  "description": "Hosting friends to watch the big game at home.",
  "category": "events",
  "subcategory": "events.game_watch_party",
  "tags": [
    "football",
    "watch-party",
    "game-day",
    "sports"
  ],
  "scenario_slots": {
    "headcount": {
      "type": "integer",
      "label": "Guests",
      "min": 2,
      "max": 40,
      "default": 12,
      "unit": "guests"
    },
    "setting": {
      "type": "enum",
      "label": "Setting",
      "options": [ "indoor", "mixed" ],
      "default": "indoor"
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [ "low", "mid", "high" ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [ "vegetarian", "vegan" ],
      "default": []
    }
  },
  "template_list": [
    {
      "item_id": "chicken_wings",
      "name": "Chicken wings",
      "category": "food",
      "qty": { "base": 72, "unit": "wings" },
      "depends_on_slots": [ "headcount", "dietary" ],
      "presence_rules": [
        { "slot_id": "dietary", "condition": "excludes", "value": "vegan" },
        { "slot_id": "dietary", "condition": "excludes", "value": "vegetarian" }
      ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 6, "round": "up" } ]
    },
    {
      "item_id": "vegetarian_wings",
      "name": "Cauliflower wings",
