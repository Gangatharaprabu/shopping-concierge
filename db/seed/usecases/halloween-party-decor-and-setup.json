      "name": "Spooky string lights",
      "category": "decor",
      "qty": { "base": 2, "unit": "set" },
      "depends_on_slots": []
    },
    {
      "item_id": "fog_machine",
      "name": "Fog machine",
      "category": "decor",
      "qty": { "base": 0, "unit": "count" },
      "depends_on_slots": [ "budget_tier" ],
      "presence_rules": [ { "slot_id": "budget_tier", "condition": "equals", "value": "high" } ]
    },
