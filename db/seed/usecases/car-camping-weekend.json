        "unit": "count"
      },
      "depends_on_slots": [
        "headcount"
      ],
      "scaling_rules": [
        {
          "slot_id": "headcount",
          "method": "step",
          "tiers": [
            {
              "up_to": 2,
              "qty": 1
            },
            {
              "up_to": 4,
              "qty": 2
            },
            {
              "up_to": null,
