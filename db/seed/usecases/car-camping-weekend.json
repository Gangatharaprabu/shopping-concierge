{
  "id": "car-camping-weekend",
  "title": "Car Camping Weekend",
  "description": "A drive-up campsite weekend with the comfort of packing straight from the car.",
  "category": "travel",
  "subcategory": "travel.camping_backpacking",
  "tags": [
    "camping",
    "outdoors",
    "weekend"
  ],
  "scenario_slots": {
    "headcount": {
      "type": "integer",
      "label": "Campers",
      "min": 1,
      "max": 10,
      "default": 4,
      "unit": "campers"
    },
    "duration": {
      "type": "duration",
      "label": "Trip length",
      "max_days": 10,
      "default": {
        "unit": "days",
        "count": 2
      }
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [
        "low",
        "mid",
        "high"
      ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [
        "vegan",
        "vegetarian"
      ],
      "default": []
    }
  },
  "template_list": [
    {
      "item_id": "tent",
      "name": "Tent",
      "category": "gear",
      "qty": {
