{
  "id": "hurricane-season-prep-kit",
  "title": "Hurricane Season Prep Kit",
  "description": "Assembling an emergency kit ahead of hurricane season.",
  "category": "seasonal",
  "subcategory": "seasonal.severe_weather_prep",
  "tags": [
    "hurricane",
    "emergency",
    "severe-weather",
    "prep"
  ],
  "scenario_slots": {
    "headcount": {
      "type": "integer",
      "label": "Household members",
      "min": 1,
      "max": 8,
      "default": 4,
      "unit": "people"
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [ "low", "mid", "high" ],
      "default": "mid"
    }
  },
  "template_list": [
    {
      "item_id": "bottled_water",
      "name": "Bottled water",
      "category": "emergency",
      "qty": { "base": 12, "unit": "gallons" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 3, "round": "up", "minimum": 3 } ],
      "notes": "3-day supply at 1 gallon/person/day."
    },
    {
      "item_id": "non_perishable_food",
      "name": "Non-perishable food",
      "category": "emergency",
      "qty": { "base": 36, "unit": "meals" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 9, "round": "up" } ]
    },
    {
      "item_id": "flashlights",
      "name": "Flashlights",
      "category": "emergency",
      "qty": { "base": 4, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "batteries",
      "name": "Batteries",
      "category": "emergency",
      "qty": { "base": 8, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 2, "round": "up" } ]
    },
    {
      "item_id": "portable_generator",
      "name": "Portable generator",
      "category": "emergency",
      "qty": { "base": 0, "unit": "count" },
      "depends_on_slots": [ "budget_tier" ],
      "presence_rules": [ { "slot_id": "budget_tier", "condition": "equals", "value": "high" } ]
