      ],
      "presence_rules": [
        {
          "slot_id": "dietary",
          "condition": "includes",
          "value": "vegan"
        }
      ],
      "scaling_rules": [
        {
          "slot_id": "headcount",
          "method": "linear",
          "per_unit": 2,
          "round": "up"
        }
      ]
    },
    {
      "item_id": "sparklers",
