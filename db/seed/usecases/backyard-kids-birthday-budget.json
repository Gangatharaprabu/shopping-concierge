      "category": "decor",
      "qty": { "base": 24, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 2, "round": "up" } ]
    },
    {
