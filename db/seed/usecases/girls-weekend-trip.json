      "category": "toiletries",
      "qty": {
        "base": 5,
        "unit": "set"
      },
      "depends_on_slots": [
        "headcount"
      ],
      "scaling_rules": [
        {
          "slot_id": "headcount",
          "method": "linear",
          "per_unit": 1,
          "round": "up"
        }
      ]
    },
    {
      "item_id": "champagne_for_toast",
