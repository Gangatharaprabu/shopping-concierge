{
  "id": "girls-weekend-trip",
  "title": "Girls' Weekend Trip",
  "description": "A short getaway with friends -- part relaxation, part night out.",
  "category": "travel",
  "subcategory": "travel.weekend_trip",
  "tags": [
    "friends",
    "weekend",
    "girls-trip"
  ],
  "scenario_slots": {
    "headcount": {
      "type": "integer",
      "label": "Travelers",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "travelers"
    },
    "duration": {
      "type": "duration",
      "label": "Trip length",
      "max_days": 7,
      "default": {
        "unit": "days",
        "count": 2
      }
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [
        "low",
        "mid",
        "high"
      ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [],
      "default": []
    }
  },
  "template_list": [
    {
      "item_id": "going_out_outfits",
      "name": "Going-out outfits",
      "category": "apparel",
      "qty": {
        "base": 5,
        "unit": "count"
      },
      "depends_on_slots": [
        "headcount"
      ],
      "scaling_rules": [
        {
          "slot_id": "headcount",
          "method": "linear",
          "per_unit": 1,
          "round": "up"
        }
      ],
      "notes": "Genuinely multiplicative with duration in theory; per README guidance, dominant slot (headcount) scales, typical trip length folded into the constant."
    },
    {
      "item_id": "phone_charger",
      "name": "Phone charger",
