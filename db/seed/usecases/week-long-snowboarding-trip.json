      ],
      "scaling_rules": [
        {
          "slot_id": "headcount",
          "method": "linear",
          "per_unit": 1,
          "round": "up"
        },
        {
          "slot_id": "duration",
          "method": "linear",
          "per_unit": 1,
          "round": "up"
        }
      ]
    }
  ]
