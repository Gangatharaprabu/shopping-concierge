{
  "id": "week-long-snowboarding-trip",
  "title": "Week-Long Snowboarding Trip",
  "description": "A full week at a mountain resort focused on snowboarding.",
  "category": "travel",
  "subcategory": "travel.ski_snow_trip",
  "tags": [
    "snowboarding",
    "ski",
    "resort",
    "week-long"
  ],
  "scenario_slots": {
    "headcount": {
      "type": "integer",
      "label": "Travelers",
      "min": 1,
      "max": 6,
      "default": 3,
      "unit": "travelers"
    },
    "duration": {
      "type": "duration",
      "label": "Trip length",
      "max_days": 14,
      "default": { "unit": "days", "count": 7 }
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [ "low", "mid", "high" ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [],
      "default": []
    }
  },
  "template_list": [
    {
      "item_id": "lift_tickets",
      "name": "Lift tickets (week pass)",
      "category": "activities",
      "qty": { "base": 3, "unit": "passes" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ],
      "notes": "Genuinely per-person-per-day, but per README guidance a typical 7-day week is folded into the constant (1 week-pass per traveler) rather than multiplying headcount x duration."
    },
    {
      "item_id": "snowboard_rental",
      "name": "Snowboard rental",
      "category": "gear",
      "qty": { "base": 3, "unit": "set" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "goggles",
      "name": "Goggles",
      "category": "gear",
      "qty": { "base": 3, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "hand_warmers",
      "name": "Hand warmers",
      "category": "gear",
      "qty": { "base": 10, "unit": "pairs" },
      "depends_on_slots": [ "headcount", "duration" ],
      "scaling_rules": [
        { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" },
        { "slot_id": "duration", "method": "linear", "per_unit": 1, "round": "up" }
      ]
    },
    {
      "item_id": "thermal_base_layers",
      "name": "Thermal base layers",
      "category": "apparel",
      "qty": { "base": 6, "unit": "sets" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 2, "round": "up" } ]
    },
    {
      "item_id": "trail_snacks",
      "name": "Trail snacks",
      "category": "food",
      "qty": { "base": 13, "unit": "bars" },
      "depends_on_slots": [ "headcount", "duration" ],
      "scaling_rules": [
        { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" },
        { "slot_id": "duration", "method": "linear", "per_unit": 1, "round": "up" }
      ]
    },
    {
      "item_id": "snow_boots",
      "name": "Snow boots",
      "category": "apparel",
      "qty": { "base": 3, "unit": "pair" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "ski_jacket_and_pants",
      "name": "Ski jacket and pants",
      "category": "apparel",
      "qty": { "base": 3, "unit": "set" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "wool_socks",
      "name": "Wool socks",
      "category": "apparel",
      "qty": { "base": 9, "unit": "pairs" },
      "depends_on_slots": [ "headcount", "duration" ],
      "scaling_rules": [
        { "slot_id": "headcount", "method": "linear", "per_unit": 2, "round": "up" },
        { "slot_id": "duration", "method": "linear", "per_unit": 0.3, "round": "up" }
      ]
    },
    {
      "item_id": "lip_balm_and_sunscreen",
      "name": "Lip balm and high-altitude sunscreen",
      "category": "toiletries",
      "qty": { "base": 3, "unit": "set" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "gear_wax_and_tuning_kit",
      "name": "Snowboard wax and tuning kit",
      "category": "gear",
      "qty": { "base": 0, "unit": "kit" },
      "depends_on_slots": [ "budget_tier" ],
      "presence_rules": [ { "slot_id": "budget_tier", "condition": "equals", "value": "high" } ]
    },
    {
      "item_id": "ski_lesson_booking",
      "name": "Private lesson booking",
      "category": "activities",
      "qty": { "base": 0, "unit": "booking" },
      "depends_on_slots": [ "headcount", "budget_tier" ],
      "presence_rules": [ { "slot_id": "budget_tier", "condition": "not_equals", "value": "low" } ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    },
    {
      "item_id": "first_aid_kit",
      "name": "First aid kit",
      "category": "gear",
      "qty": { "base": 1, "unit": "count" },
      "depends_on_slots": []
    },
    {
      "item_id": "apres_ski_hot_cocoa_supplies",
      "name": "Après-ski hot cocoa supplies",
      "category": "food",
      "qty": { "base": 1, "unit": "set" },
      "depends_on_slots": []
    },
    {
      "item_id": "neck_gaiter_or_balaclava",
      "name": "Neck gaiter or balaclava",
      "category": "apparel",
      "qty": { "base": 3, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 1, "round": "up" } ]
    }
  ]
}
