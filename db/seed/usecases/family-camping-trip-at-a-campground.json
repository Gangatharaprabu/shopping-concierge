{
  "id": "family-camping-trip-at-a-campground",
  "title": "Family Camping Trip at a Campground",
  "description": "A kid-friendly camping trip at a developed campground.",
  "category": "travel",
  "subcategory": "travel.camping_backpacking",
  "tags": [
    "camping",
    "family",
    "kids",
    "campground"
  ],
  "scenario_slots": {
    "headcount": {
      "type": "integer",
      "label": "Campers",
      "min": 2,
      "max": 12,
      "default": 5,
      "unit": "campers"
    },
    "duration": {
      "type": "duration",
      "label": "Trip length",
      "max_days": 14,
      "default": { "unit": "days", "count": 3 }
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [ "low", "mid", "high" ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [ "nut_free" ],
      "default": []
    }
  },
  "template_list": [
    {
      "item_id": "family_tent",
      "name": "Family tent",
      "category": "gear",
      "qty": { "base": 1, "unit": "count" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "step", "tiers": [ { "up_to": 4, "qty": 1 }, { "up_to": 8, "qty": 2 }, { "up_to": null, "qty": 3 } ] } ]
    },
    {
      "item_id": "sleeping_bags",
      "name": "Sleeping bags",
      "category": "gear",
      "qty": { "base": 5, "unit": "count" },
