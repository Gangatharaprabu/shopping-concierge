      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "step", "tiers": [ { "up_to": 20, "qty": 20 }, { "up_to": 40, "qty": 40 }, { "up_to": null, "qty": 70 } ] } ]
    },
    {
      "item_id": "appetizer_spread",
