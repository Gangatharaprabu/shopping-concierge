{
  "id": "milestone-adult-birthday-at-home",
  "title": "Milestone Adult Birthday at Home",
  "description": "A 30th/40th/50th-style birthday celebration hosted at home in the evening.",
  "category": "events",
  "subcategory": "events.birthday_party",
  "tags": [
    "birthday",
    "adult",
    "milestone",
    "celebration"
  ],
  "scenario_slots": {
    "time_of_day": {
      "type": "enum",
      "label": "Time of day",
      "options": [
        "day",
        "night"
      ],
      "default": "night"
    },
    "headcount": {
      "type": "integer",
      "label": "Guests",
      "min": 4,
      "max": 60,
      "default": 20,
      "unit": "guests"
    },
    "setting": {
      "type": "enum",
      "label": "Setting",
      "options": [
        "indoor",
        "outdoor",
        "mixed"
      ],
      "default": "indoor"
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [
        "low",
        "mid",
        "high"
      ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [
        "vegan",
        "vegetarian",
        "gluten_free"
      ],
      "default": []
    }
  },
