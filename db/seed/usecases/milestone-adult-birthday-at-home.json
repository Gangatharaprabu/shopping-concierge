{
  "id": "milestone-adult-birthday-at-home",
  "title": "Milestone Adult Birthday at Home",
  "description": "A 30th/40th/50th-style birthday celebration hosted at home in the evening.",
  "category": "events",
  "subcategory": "events.birthday_party",
  "tags": [
    "birthday",
    "adult",
    "milestone",
    "celebration"
  ],
  "scenario_slots": {
    "time_of_day": {
      "type": "enum",
      "label": "Time of day",
      "options": [ "day", "night" ],
      "default": "night"
    },
    "headcount": {
      "type": "integer",
      "label": "Guests",
      "min": 4,
      "max": 60,
      "default": 20,
      "unit": "guests"
    },
    "setting": {
      "type": "enum",
      "label": "Setting",
      "options": [ "indoor", "outdoor", "mixed" ],
      "default": "indoor"
    },
    "budget_tier": {
      "type": "enum",
      "label": "Budget",
      "options": [ "low", "mid", "high" ],
      "default": "mid"
    },
    "dietary": {
      "type": "tag_list",
      "label": "Dietary needs",
      "options": [ "vegan", "vegetarian", "gluten_free" ],
      "default": []
    }
  },
  "template_list": [
    {
      "item_id": "birthday_cake",
      "name": "Birthday cake",
      "category": "food",
      "qty": { "base": 1, "unit": "cake" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "step", "tiers": [ { "up_to": 20, "qty": 1 }, { "up_to": 40, "qty": 2 }, { "up_to": null, "qty": 3 } ] } ]
    },
    {
      "item_id": "vegan_cake_alternative",
      "name": "Vegan cake alternative",
      "category": "food",
      "qty": { "base": 0, "unit": "cake" },
      "depends_on_slots": [ "dietary" ],
      "presence_rules": [ { "slot_id": "dietary", "condition": "includes", "value": "vegan" } ]
    },
    {
      "item_id": "champagne",
      "name": "Champagne for toasting",
      "category": "drinks",
      "qty": { "base": 3, "unit": "bottle" },
      "depends_on_slots": [ "headcount" ],
      "scaling_rules": [ { "slot_id": "headcount", "method": "linear", "per_unit": 0.15, "round": "up", "minimum": 1 } ]
    },
    {
      "item_id": "string_lights",
      "name": "String lights",
      "category": "decor",
      "qty": { "base": 1, "unit": "set" },
      "depends_on_slots": [ "time_of_day" ],
      "presence_rules": [ { "slot_id": "time_of_day", "condition": "equals", "value": "night" } ]
    },
    {
      "item_id": "photo_backdrop",
      "name": "Photo backdrop",
      "category": "decor",
